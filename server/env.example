PORT=3000
NODE_ENV=development

# Local Postgres for dev; Neon connection string in production (see docs/signalAI_roadmap.md Tech Stack).
DATABASE_URL=postgres://localhost:5432/signalai_dev

# From the Meta Developer App (Phase 0 / A4) — required for the Data Deletion
# Callback and, later, webhook signature verification.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Token vault (Phase 1 Security Foundations): "v1:<base64 32-byte key>,v2:<...>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real value here — this file only documents the shape.
TOKEN_ENCRYPTION_KEYS=

# B10: hard per-account daily cap on AI-generated (not rule-based) replies.
# Defaults to 300 if unset — see src/config.ts.
AI_DAILY_CALL_CAP=300

# R10-01: signs the bearer session issued at the end of a successful
# Instagram connection. Required — the server refuses to boot without it,
# since an empty secret would make every tenant session forgeable.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# B11: Telegram alerts for new leads and operational alarms (B4/B5/B10).
# Create a bot via @BotFather, then message it once and fetch the chat id
# from https://api.telegram.org/bot<token>/getUpdates. Alerts are silently
# skipped (logged as a warning) when either is unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# B11: Single Flat Plan via Stripe Checkout. STRIPE_PRICE_ID is the one
# recurring Price object for the flat plan. The billing routes 503 rather
# than crash when these are unset.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Where BUI (the React app) lives — used to build the Checkout
# success/cancel redirect URLs.
APP_BASE_URL=http://localhost:5173
# Origin BUI's dev server runs on, for CORS. Required — the server refuses
# to boot without it (R12-01): it is echoed as Access-Control-Allow-Origin
# and no longer falls back to a wildcard when unset.
WEB_APP_ORIGIN=http://localhost:5173
